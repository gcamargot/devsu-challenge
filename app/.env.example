# App
PORT=8000

# Database backend: "sqlite" (default, local/dev) or "postgres" (kubernetes)
DB_DIALECT=sqlite

# sqlite: ":memory:" (default) or a file path to persist between restarts
# DB_STORAGE=./dev.sqlite

# postgres (used when DB_DIALECT=postgres)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=devsu
# DB_USER=devsu
# DB_PASSWORD=changeme
