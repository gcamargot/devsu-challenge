    "coverageReporters": [
      "text",
      "lcov"
    ]
  },
  "author": "Devsu",
  "dependencies": {
    "dotenv": "16.0.3",
    "express": "4.21.2",
    "pg": "8.21.0",
    "pg-hstore": "2.3.4",
    "sequelize": "6.37.8",
    "yup": "1.0.2"
  },
  "devDependencies": {
    "@babel/preset-env": "7.21.4",
    "@eslint/js": "10.0.1",
    "@types/express": "4.17.17",
    "babel-jest": "29.5.0",
    "eslint": "10.4.1",
    "globals": "17.6.0",
    "jest": "29.5.0",
    "sqlite3": "5.1.7",
    "supertest": "6.3.3"
  },
  "overrides": {
    "express": {
      "path-to-regexp": "0.1.13"
    },
    "picomatch": "4.0.4"
  }
